{
  "name": "reto-01-registro-proveedor",
  "version": "1.0.0",
  "description": "Agente conversacional para registro como proveedor",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "demo": "tsx demo.ts",
    "dev:server": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:web": "vite",
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "build:web": "vite build",
    "build": "npm run build:web",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "verify:modulo": "tsx scripts/verificar-modulo.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@azure/identity": "^4.5.0",
    "@azure/keyvault-secrets": "^4.9.0",
    "exceljs": "4.4.0",
    "express": "4.21.2",
    "pdfkit": "0.15.2",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "20.17.17",
    "@types/pdfkit": "0.13.9",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "^4.23.15",
    "typescript": "5.7.3",
    "vite": "5.4.14"
  }
}
