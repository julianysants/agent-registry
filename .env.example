# Proveedor LLM (OpenRouter, API compatible con OpenAI)
# Obtén tu clave en https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Endpoint base (OpenRouter por defecto)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Modelo a usar (ej: openai/gpt-4o, openai/gpt-4o-mini, google/gemini-2.0-flash-001)
LLM_MODEL=openai/gpt-4o-mini

# Límites de costo/seguridad
MAX_ITERACIONES=25
MAX_TOKENS_SESION=120000
LLM_TIMEOUT_MS=60000
LLM_MAX_TOKENS_RESPUESTA=1024

# Puerto del backend
PORT=8787

# Fecha de referencia para calcular vigencias de soportes (YYYY-MM-DD).
# Si se deja vacío usa la fecha actual del sistema.
FECHA_EJECUCION=

# --- Azure Key Vault (OPCIONAL, solo para despliegue en Azure) ---
# Si KEY_VAULT_URI está definido, el backend lee la clave del modelo desde
# Key Vault usando la managed identity (no se necesita OPENROUTER_API_KEY aquí).
# En local se deja vacío y se usa OPENROUTER_API_KEY del .env.
KEY_VAULT_URI=
OPENROUTER_SECRET_NAME=openrouter-api-key
